# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- Virtual envs ---
.venv/
venv/
env/

# --- Secrets / config ---
.env
.env.*
!.env.example
*.key

# --- Tooling caches ---
.pytest_cache/
.ruff_cache/

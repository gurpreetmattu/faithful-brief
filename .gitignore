# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- Virtual envs ---
.venv/
venv/
env/

# --- Secrets / config ---
.env
.env.*
!.env.example
*.key

# --- Tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Editor / OS ---
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store

# --- Data ---
# The frozen corpus and ground-truth labels ARE committed (invariant 4: corpus is
# versioned/pinned) -- data/cache/ holds the actual raw artifacts corpus.v1.json's
# sha256_content hashes pin, and check_claims_integrity.py's mechanical span
# re-verification depends on it being present in a clean checkout (found via a
# real fast-checks CI failure: it passed locally only because data/cache/ already
# existed on disk). Only transient run logs are ignored.
data/logs/
data/**/*.tmp
*.log

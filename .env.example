# Copy to .env (gitignored) and fill in.
GROQ_API_KEY=
HF_TOKEN=

# Optional: override the model used per provider (both Writer and Verifier use the
# same model within a given provider -- specs/writer-verifier.md Sec 11).
# AGENT_MODEL_GROQ=openai/gpt-oss-20b
# AGENT_MODEL_HF=meta-llama/Llama-3.3-70B-Instruct

# Optional: Langfuse observability (augments data/logs/call_log.jsonl, doesn't
# replace it -- see llm_client.py).
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=

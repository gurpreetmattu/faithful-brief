# Copy to .env (gitignored) and fill in.
# Providers tried in this order (llm_client.py) -- each is a genuinely separate
# quota, not just a different key on the same account:
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=

# Optional: override the model used per provider (both Writer and Verifier use the
# same model within a given provider -- specs/writer-verifier.md Sec 11).
# AGENT_MODEL_GROQ=openai/gpt-oss-20b
# AGENT_MODEL_GEMINI=gemini-3.6-flash
# AGENT_MODEL_OPENROUTER=nvidia/nemotron-3-super-120b-a12b:free
# AGENT_MODEL_HF=meta-llama/Llama-3.3-70B-Instruct

# Optional: Langfuse observability (augments data/logs/call_log.jsonl, doesn't
# replace it -- see llm_client.py).
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=
